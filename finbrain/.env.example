# Default is a fully offline, extractive demonstration.
FINBRAIN_ANSWER_MODE=extractive
# Set remote only when ready to send authorized synthetic evidence to your model.
FINBRAIN_MODEL_URL=https://your-provider.example/v1/chat/completions
FINBRAIN_MODEL_NAME=your-model-name
FINBRAIN_MODEL_KEY=
# Optional Fernet key. Without it, a local key is created in runtime/ (not production KMS).
FINBRAIN_DATA_KEY=
